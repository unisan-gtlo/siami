# Vhost nginx (HOST, bukan di dalam Docker) untuk siami.unisan-g.id.
# Pola sama persis dengan alumni.unisan-g.id.conf / siobe.unisan-g.id.conf yang
# sudah berjalan di server ini: /etc/nginx/conf.d/<nama>.conf (gaya RHEL, BUKAN
# sites-available/sites-enabled).
#
# Cara pasang (jalankan sebagai user dengan sudo -- butuh password interaktif,
# tidak dijalankan otomatis dari sini):
#
#   sudo cp ~/siami/deploy/nginx-siami.conf.sample /etc/nginx/conf.d/siami.unisan-g.id.conf
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d siami.unisan-g.id
#
# PENTING: kalau nanti certbot menulis ulang berkas live (menambah blok SSL/443),
# salin balik isinya ke file repo ini sebelum dipakai lagi sebagai sumber `cp`,
# supaya repo & live tidak drift (lihat insiden serupa yang pernah terjadi di
# siobe.unisan-g.id.conf).

server {
    server_name siami.unisan-g.id;

    client_max_body_size 20m;  # upload dokumen bukti AMI bisa cukup besar

    location / {
        proxy_pass http://127.0.0.1:8012;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 80;
    listen [::]:80;
}
