# ============================================
# SI-AMI UNISAN - Environment Variables Template
# Copy file ini menjadi .env, lalu isi dengan value sebenarnya
# JANGAN COMMIT .env KE GIT!
# ============================================

# Django Core
SECRET_KEY=generate-dengan-django-utility-get-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# WAJIB diisi untuk deploy produksi (Docker):
# DJANGO_SETTINGS_MODULE=ami_project.settings.production

# Database PostgreSQL (container sendiri, lihat docker-compose.yml)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=siami
DB_USER=siami
DB_PASSWORD=ganti-dengan-password-kuat
DB_HOST=localhost
DB_PORT=5432
# Saat jalan via docker-compose, DB_HOST harus mengarah ke nama service:
# DB_HOST=db

# Gunicorn (dipakai entrypoint.sh saat deploy Docker)
# Timeout dinaikkan karena VPS ini berbagi resource dengan banyak stack lain
# (RAM sering mepet + swap terpakai) -- worker sync bisa telat heartbeat kalau
# host sedang sibuk, bukan berarti request itu sendiri lambat.
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120

# SSO Configuration
SSO_BASE_URL=https://portal.unisan-g.id

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
