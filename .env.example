# ============================================
# SI-AMI UNISAN - Environment Variables Template
# Copy file ini menjadi .env, lalu isi dengan value sebenarnya
# ============================================

# Django Core
SECRET_KEY=generate-dengan-django-utility-get-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=unisan_db
DB_USER=ami_user
DB_PASSWORD=ganti-dengan-password-kuat
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=ami

# SSO Configuration
SSO_BASE_URL=https://portal.unisan-g.id

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend